# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Required for "Add user" in Admin → Users (server-only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI ramp design suggestions in Admin → Skateramps
OPENAI_API_KEY=

# Email notifications (Resend — https://resend.com). Optional: custom ramp requests
# are always stored and visible in Admin → Solicitudes de rampa; the key only adds
# the Gmail notification. MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=NiikSkate <hola@niikskate.com>
CONTACT_INBOX_EMAIL=niikskateacademy@gmail.com

# NiikSkate member mobile app (Capacitor) — optional until App Store / Play publish
NUXT_PUBLIC_MEMBER_APP_IOS_URL=
NUXT_PUBLIC_MEMBER_APP_ANDROID_URL=
NUXT_PUBLIC_MEMBER_APP_DEEP_LINK=niikskate://member

# Local dev on Windows behind corporate VPN/proxy (e.g. AMDOCS): Node may fail Supabase HTTPS
# with "self-signed certificate in certificate chain". start-app.bat and npm run dev handle this
# automatically on Windows. Set to 0 to disable; set to 1 to force on Mac/Linux.
# NIIK_ALLOW_INSECURE_TLS=0
